# Django secret key — required, must be a long random string in production
SECRET_KEY=your-secret-key-here

# Debug mode — set to False in production
DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# PostgreSQL connection string — required
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# ── PayHero ───────────────────────────────────────────────────────────────────
# From the PayHero dashboard: Settings → API Keys → Add new API Key
# Option A — username + password
PAYHERO_USERNAME=your-payhero-api-username
PAYHERO_PASSWORD=your-payhero-api-password

# Option B — pre-encoded Basic token (leave blank if using Option A)
# PAYHERO_BASIC_AUTH_TOKEN=

# Numeric channel ID — PayHero dashboard → Payment Channels → My Payment Channels
PAYHERO_CHANNEL_ID=your-channel-id
